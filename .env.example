# "fixture" (default) places no real calls — safe to run with zero credentials.
# "live" places real CALL-E calls and requires CALLE_API_KEY below.
CALLE_MODE=fixture

# Required only when CALLE_MODE=live. Get one from your CALL-E beta onboarding.
CALLE_API_KEY=

# Defaults to the public CALL-E API host; override only if your onboarding
# gave you a different beta host.
CALLE_BASE_URL=https://api.heycall-e.com
